# ============================================================================
#  AkaLink — Contoh variabel lingkungan
# ----------------------------------------------------------------------------
#  Cara pakai:
#    1. Salin file ini menjadi ".env"  (perintah: cp .env.example .env)
#    2. Isi nilai di bawah dengan data dari dashboard Supabase Anda.
#    3. JANGAN pernah commit file ".env" asli (sudah diabaikan oleh .gitignore).
# ============================================================================

# --- Supabase: Database (PostgreSQL) ----------------------------------------
# Ambil dari: Supabase Dashboard -> Project Settings -> Database -> Connection string
# Pilih tab "Transaction pooler" (port 6543) untuk dipakai aplikasi.
# Ganti [PASSWORD] dengan password database yang Anda buat saat membuat project.
DATABASE_URL="postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"

# --- Supabase: API (dipakai untuk Auth & Storage pada Phase 0.5) -------------
# Ambil dari: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-public-key]"

# Kunci rahasia (server-only). JANGAN diawali NEXT_PUBLIC_ dan jangan bocor ke klien.
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"
